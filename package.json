{
  "name": "@yukinuma/agent-bridge-mcp",
  "version": "0.3.0",
  "description": "Capability-aware MCP and HTTP runtime for orchestrating interchangeable coding agents with sessions, workflows, evidence, and review gates",
  "type": "module",
  "main": "dist/server/mcp-server.js",
  "types": "dist/server/mcp-server.d.ts",
  "bin": {
    "agent-bridge-mcp": "./dist/server/mcp-server.js",
    "agent-bridge-gateway": "./dist/start-gateway.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server/mcp-server.js",
    "gateway": "node dist/start-gateway.js",
    "test:full": "node dist/test-full-spec.js",
    "test:hardening": "node dist/test-hardening.js",
    "test:agents:e2e": "node dist/test-agents-e2e.js",
    "test:ci": "npm run typecheck && npm run build && npm run test:hardening",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude-code",
    "codex",
    "agent",
    "orchestration",
    "workflow",
    "multi-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yukinuma-cpu/agent-bridge-mcp.git"
  },
  "homepage": "https://github.com/yukinuma-cpu/agent-bridge-mcp#readme",
  "bugs": {
    "url": "https://github.com/yukinuma-cpu/agent-bridge-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@hono/node-server": "^1.13.8",
    "@modelcontextprotocol/sdk": "^1.6.0",
    "@openai/codex-sdk": "^0.147.0",
    "hono": "^4.7.2",
    "ws": "^8.18.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/ws": "^8.5.14",
    "typescript": "^5.8.2"
  },
  "license": "MIT"
}
